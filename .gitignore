.worktrees/

# Sekrety i ustawienia lokalne
.env
.env.*
*.pem
*.key

# Dane, wagi i wyniki: w Git pozostaje tylko opis katalogu
/data/*
!/data/README.md
/models/*
!/models/README.md
/weights/**
!/weights/c5-alpha-0.1/
!/weights/c5-alpha-0.1/README.md
/outputs/*
!/outputs/README.md

